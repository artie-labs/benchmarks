# Copy to run/.env (gitignored) and fill in. bench.sh sources it.

# Kubernetes: the EKS cluster running Kafka, Kafka Connect and the pgbench pod.
KUBE_CONTEXT=
NAMESPACE=default
# Only for plugin tools (see "Plugin tools" in run/README.md): the directory with their bench_<tool>.sh files.
TOOLS_DIR=

# AWS: the account with the RDS, DMS and S3 resources from aws/dms/tf.
AWS_PROFILE=
AWS_REGION=us-west-2
# Optional. Defaults to db_password in aws/dms/tf/terraform.tfvars.
# PGPASSWORD=

# Snowflake: a `snow` CLI connection name from ~/.snowflake/config.toml.
SNOW_CONNECTION=
# The benchmark database and schema. Every tool writes here, except Openflow (OF_DB).
SF_DB=
SF_SCHEMA=BENCHMARK
SF_INTEGRATION=benchmark_dms_s3
# Each tool in a run needs its own warehouse; `check` refuses two on the same one.
DMS_WH=BENCHMARK_WH_2   # DMS's merge task
DBZ_WH=BENCHMARK_WH     # Debezium's merge task
OF_WH=BENCHMARK_WH      # Openflow's merges
# bench.sh runs all its own queries here, so they don't count as any tool's cost.
MEASURE_WH=COMPUTE_WH
# Openflow only (see openflow/README.md): its destination database, the JDBC driver jar, and its compute pools for
# `cost` (from METERING_HISTORY; they don't show in SHOW COMPUTE POOLS), comma-separated.
# OF_DB=OPENFLOW_BENCHMARK
OF_DRIVER=
OF_POOLS=

# Which tools snapshots and CDC runs include, space-separated: dms, debezium, openflow, or a plugin tool. TOOLS in the
# environment overrides this line.
TOOLS=debezium

# Workload
INIT_SCALE=1000   # 100M rows in pgbench_accounts
LOAD_SCALE=1      # :scale for custom_tpcb.sql. 1 = 100,000 distinct accounts, as in the published run. 1000 = all 100M.
CLIENTS=50
THREADS=8
DURATION=600
SNAPSHOT_RUNS=3
CDC_RUNS=3

# Debezium: the Kafka Connect worker's size during snapshots and CDC runs.
# DBZ_SNAPSHOT_CPU=4
# DBZ_SNAPSHOT_MEMORY=8Gi
# DBZ_SNAPSHOT_HEAP=4g
# DBZ_SNAPSHOT_THREADS=10      # snapshot.max.threads: primary-key ranges read in parallel
# DBZ_SNAPSHOT_PARTITIONS=8    # snapshot topic partitions and Snowflake connector tasks
# DBZ_CDC_CPU=1
# DBZ_CDC_MEMORY=3Gi
# DBZ_CDC_HEAP=1536m

# Results go to data/runs/$RUN_ID. Defaults to today's UTC date. RUN_ID in the environment overrides this line.
# RUN_ID=
